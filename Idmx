
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HomeworkHelper | Games</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #0b0912;
  color: white;
  font-family: Arial, sans-serif;
}
header {
  padding: 22px;
  background: #151020;
  border-bottom: 1px solid #392650;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
h1 { color: #b77aff; margin: 0; }
main { padding: 25px; max-width: 1100px; margin: auto; }
h2 { color: #c99aff; }
input {
  width: 100%;
  padding: 15px;
  border-radius: 10px;
  border: 1px solid #67438c;
  background: #191326;
  color: white;
  font-size: 16px;
  margin: 15px 0 25px;
}
.games {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
  gap: 18px;
}
.game {
  background: #1b1427;
  border: 1px solid #38264e;
  border-radius: 13px;
  padding: 20px;
  text-align: center;
  transition: .2s;
}
.game:hover {
  transform: translateY(-5px);
  border-color: #b77aff;
}
.game .emoji { font-size: 45px; }
.game h3 { margin-bottom: 8px; }
.game a {
  display: inline-block;
  background: #8b45d6;
  color: white;
  padding: 10px 18px;
  border-radius: 8px;
  text-decoration: none;
}
footer {
  text-align: center;
  padding: 30px;
  color: #887a9b;
}
</style>
</head>
<body>
<header>
  <h1>🎮 HomeworkHelper</h1>
  <span>GAMES</span>
</header>
<main>
  <h2>Welcome to HomeworkHelper</h2>
  <p>Find your next favorite game!</p>

  <input id="search" placeholder="🔍 Search games...">

  <h2>All Games</h2>
  <div class="games" id="games">
    <div class="game">
      <div class="emoji">🏃</div>
      <h3>Run 3</h3>
      <a href="https://www.coolmathgames.com/0-run-3" target="_blank" rel="noopener">Play</a>
    </div>
    <div class="game">
      <div class="emoji">🧩</div>
      <h3>2048</h3>
      <a href="https://play2048.co/" target="_blank" rel="noopener">Play</a>
    </div>
    <div class="game">
      <div class="emoji">♟️</div>
      <h3>Chess</h3>
      <a href="https://www.chess.com/play" target="_blank" rel="noopener">Play</a>
    </div>
    <div class="game">
      <div class="emoji">🕹️</div>
      <h3>Scratch Games</h3>
      <a href="https://scratch.mit.edu/explore/projects/games/" target="_blank" rel="noopener">Play</a>
    </div>
  </div>
</main>
<footer>HomeworkHelper © 2026</footer>

<script>
const search = document.getElementById("search");
search.addEventListener("input", () => {
  const term = search.value.toLowerCase();
  document.querySelectorAll(".game").forEach(game => {
    game.style.display =
      game.innerText.toLowerCase().includes(term) ? "" : "none";
  });
});
</script>
</body>
</html>
